{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEGIS -- Agentic Engineering Governance & Implementation System: a governed SDLC orchestration engine, demonstrated against a URL-shortener target project.",
  "scripts": {
    "dev": "tsx src/orchestrator/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "tsx src/target-project/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
